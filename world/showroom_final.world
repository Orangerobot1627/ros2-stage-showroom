# Technology exhibition hall: 50 m x 35 m, 0.05 m/cell.
# Robot order is intentional: robot_0 = guide, robot_1 = coffee delivery.

include "include/showroom_robots.inc"

resolution 0.05
interval_sim 50
paused 0
speedup 3.0

define showroom_floorplan model
(
  color "gray35"
  boundary 1
  gui_nose 0
  gui_grid 0
  gui_outline 0
  gripper_return 0
  fiducial_return 0
  ranger_return 1
)

window
(
  size [ 1200 820 ]
  scale 21.0
  center [ 0 0 ]
  rotate [ 0 0 ]
  # Keep LiDAR topics active without drawing 1080 rays every frame. This avoids
  # VMware vmwgfx command-buffer crashes; data can still be enabled in the GUI.
  show_data 0
)

showroom_floorplan
(
  name "showroom"
  size [ 50.0 35.0 0.80 ]
  pose [ 0 0 0 0 ]
  bitmap "maps/showroom_final.pgm"
  gui_move 0
)

# Orange box parked beside the entrance aisle. It is draggable in the GUI and
# returns here every time Stage is restarted.
include "include/showroom_test_obstacles.inc"

guide_robot
(
  name "robot_0"
  pose [ 0.0 -14.5 0 90 ]
  color "DodgerBlue"
)

coffee_robot
(
  name "robot_1"
  pose [ 2.3 -14.5 0 90 ]
  color "LimeGreen"
)

# Non-colliding colored dots make the planned paths visible in the Stage GUI.
include "include/showroom_routes.inc"
